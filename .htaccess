<IfModule mod_rewrite.c>
  RewriteEngine On

  # Force HTTPS + WWW
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} !^www\.shivalikventures\.com$ [NC]
  RewriteRule ^ https://www.shivalikventures.com%{REQUEST_URI} [R=301,L]

  # SPA fallback — serve index.html for all non-file, non-directory requests
  RewriteBase /
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ /index.html [L]
</IfModule>