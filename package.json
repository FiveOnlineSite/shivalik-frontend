    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "postbuild": "react-snap"
  },
  "reactSnap": {
    "include": [
      "/",
      "/about-us",
      "/projects",
      "/csr",
      "/faqs",
      "/emi-calculator",
      "/stamp-duty-calculator",
      "/news",
      "/project/gulmohar-avenue",
      "/project/prabhat-darshan",
      "/blogs",
      "/blog/bandras-best-kept-secret-luxury-living-on-a-budget",
      "/blog/investing-in-bandras-future-affordable-luxury-homes-by-shivalik-ventures",
      "/blog/a-guide-to-buying-your-first-affordable-home-in-mumbai",
      "/blog/top-10-reasons-to-buy-a-home-in-bandra",
      "/blog/get-your-dream-home-in-mumbai-how-to-secure-the-right-home-loan",
      "/blog/no-more-renting-how-to-use-home-loans-to-transition-to-mumbai-homeownership",
      "/contact-us",
      "/login"

    ],
    "crawl": false,
    "skipThirdPartyRequests": false,
    "inlineCss": false,
    "waitFor": "#react-snap-ready",
     "navigationTimeout": 120000,
    "puppeteerArgs": [
      "--no-sandbox",
      "--disable-setuid-sandbox"
    ]
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "ajv": "^6.12.6",
    "ajv-keywords": "^3.5.2",
    "html-webpack-plugin": "^5.6.4",
    "react-snap": "^1.23.0"
  },
  "allowScripts": {
    "puppeteer@1.20.0": true
  }
